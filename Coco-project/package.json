{
  "name": "coco-project",
  "version": "1.0.0",
  "description": "Coco - Premium Glassmorphism AI Chatbot",
  "private": true,
  "scripts": {
    "start": "concurrently \"npm run start:server\" \"npm run start:app\"",
    "start:server": "cd server && npm run dev",
    "start:app": "cd app && npm run dev",
    "install:all": "npm install && cd server && npm install && cd ../app && npm install"
  },
  "devDependencies": {
    "autoprefixer": "^10.5.4",
    "concurrently": "^8.2.2",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.1"
  }
}
